apiVersion: v1
kind: Secret
metadata:
  name: cosmic-flight-sim-secrets
  namespace: cosmic-flight-sim
  labels:
    app: cosmic-flight-simulator
type: Opaque
stringData:
  # API Secret Key - CHANGE THIS IN PRODUCTION!
  API_SECRET_KEY: "dev-secret-key-please-change-in-production"

  # MongoDB Credentials (if using authentication)
  # MONGODB_USERNAME: "your-username"
  # MONGODB_PASSWORD: "your-password"

  # Alternative: Full MongoDB URI (overrides host/port)
  # MONGODB_URI: "mongodb://username:password@mongodb-service:27017/cosmic_flight_sim"
